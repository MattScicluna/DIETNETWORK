[flake8]
# Matches black's line length, so a line black accepts is never a lint error.
max-line-length = 100
extend-ignore = E203,W503,E501,F841,F541
# The pre-refactor code under Dietnet/ predates linting; it is linted for real
# errors (undefined names, bad syntax) but not for style it is about to lose in
# the Phase 2 restructure. New code is held to the full rule set.
per-file-ignores =
    Dietnet/*:E1,E2,E3,E7,W2,W3,W6,F401,F403,F405,F811,E722,E731,E741
