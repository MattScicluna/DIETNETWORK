# samples x 2,000 SNPs of the public 1000 Genomes data that the published
# Zenodo release distributes (`dietnet published`); synthetic is simulated.
# Neither carries cohort data. Reviewed 2026-10-25, comment updated 2026-10-26.
tests/fixtures/kgp_mini.bed:genotype-data
tests/fixtures/kgp_mini.bim:genotype-data
tests/fixtures/kgp_mini.fam:genotype-data
tests/fixtures/kgp_mini_upstream.hdf5:data-container
tests/fixtures/synthetic.bed:genotype-data
tests/fixtures/synthetic.bim:genotype-data
tests/fixtures/synthetic.fam:genotype-data
tests/fixtures/synthetic_upstream.hdf5:data-container

